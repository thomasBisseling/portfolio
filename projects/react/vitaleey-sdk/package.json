{
  "name": "api-sdk-react",
  "version": "0.0.1",
  "license": "SEE LICENSE IN LICENSE.md",
  "main": "dist/index.js",
  "engines": {
    "node": ">=8",
    "npm": ">=5"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c",
    "start": "rollup -c -w",
    "test": "jest --runInBand",
    "test:ci:unit": "yarn test:ci --testMatch='<rootDir>/src/**/*.spec.(ts|tsx)'",
    "test:ci:integration": "yarn test:ci --testMatch='<rootDir>/src/**/*.test.integration.(ts|tsx)'",
    "test:ci": "jest --ci --runInBand --reporters=default --reporters=jest-junit --coverage",
    "test:cov:unit": "yarn test:unit --coverage",
    "test:cov:integration": "yarn test:integration --coverage",
    "test:unit": "jest --testMatch='<rootDir>/src/**/*.spec.(ts|tsx)'",
    "test:integration": "jest --testMatch='<rootDir>/src/**/*.test.integration.(ts|tsx)'",
    "format": "prettier --write src/**/*.ts src/**/*.tsx",
    "format:check": "prettier --check src/**/*.ts src/**/*.tsx",
    "lint": "eslint ",
    "semantic-release": "semantic-release"
  },
  "peerDependencies": {
    "react": ">= 16.8.0",
    "react-dom": ">= 16.8.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.24.1",
    "@eslint/js": "^9.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/gitlab": "^13.0.3",
    "@testing-library/react": "^15.0.2",
    "@types/jest": "^29.5.12",
    "@types/react": "^16.3.13",
    "@types/react-dom": "^16.0.5",
    "babel-core": "^6.26.3",
    "babel-runtime": "^6.26.0",
    "cobertura-merge": "^1.0.4",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^4.0.8",
    "form-data": "^4.0.0",
    "global-jsdom": "^24.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jsdom": "^24.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-test-renderer": "^16.13.1",
    "rollup": "^1.29.0",
    "rollup-plugin-sass": "^1.2.2",
    "rollup-plugin-typescript2": "^0.25.3",
    "rollup-plugin-uglify": "^6.0.4",
    "semantic-release": "^23.0.8",
    "ts-jest": "^29.1.2",
    "tsconfig-paths-jest": "^0.0.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.7.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "react hooks",
    "typescript",
    "npm"
  ],
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/nock": "^11.1.0",
    "axios": "^1.6.8",
    "jest-unit": "^0.0.2",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "nock": "^13.5.4",
    "prettier": "^3.2.5",
    "prop-types": "^15.7.2"
  }
}
